runtime: nodejs22
env: standard

instance_class: F1

automatic_scaling:
  max_instances: 5

env_variables:
  NODE_ENV: "production"
  CLIENT_ORIGIN: "https://your-domain.com"
  COOKIE_SECURE: "true"
  COOKIE_SAME_SITE: "none"
  MONGODB_URI: "mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=your-app"
  JWT_SECRET: "your-jwt-secret-here"
  # Shared secret for the recurring-entries cron. Must match CRON_SECRET set on
  # the Cloudflare MCP worker (wrangler secret put CRON_SECRET).
  CRON_SECRET: "your-cron-secret-here"
  # Private Cloud Storage bucket the nightly backup writes to. Leave unset to
  # switch the backup off. The App Engine service account needs Storage Object
  # Admin on it. BACKUP_KEEP is how many nightly dumps to keep (default 30).
  BACKUP_BUCKET: "your-project-backups"
  RESEND_API_KEY: "re_your_api_key_here"
  RESEND_FROM_EMAIL: "Your App <noreply@yourdomain.com>"
  # Secret required to create an additional business account via
  # POST /api/auth/signup. Leave this unset to keep account creation disabled:
  # the route 403s rather than falling open, so a missing value can never
  # silently expose public registration.
  SIGNUP_INVITE_CODE: "generate-a-long-random-string"
  # Slot Finder (/api/slot-finder). Reads the owner's Google Calendar (read-only)
  # and prices drives with the Google Routes API. Nothing here is ever returned
  # by the API. GOOGLE_CALENDAR_ACCOUNT_ID is the account (Settings _id) whose
  # calendar this is; other accounts get a 403, and the feature stays off (503)
  # until it is set.
  GOOGLE_CALENDAR_CLIENT_ID: "your-oauth-client-id.apps.googleusercontent.com"
  GOOGLE_CALENDAR_CLIENT_SECRET: "your-oauth-client-secret"
  GOOGLE_CALENDAR_REFRESH_TOKEN: "refresh-token-with-calendar.readonly-scope"
  GOOGLE_CALENDAR_ID: "primary"
  GOOGLE_CALENDAR_ACCOUNT_ID: "your-account-object-id"
  # A key restricted to the Routes API.
  GOOGLE_MAPS_API_KEY: "your-routes-api-key"
